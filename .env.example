# ============================
# api- 单一钱包API和机台任务进程
# 端口: 8788
# ============================

APP_DEBUG=true
APP_ENV=dev
APP_KEY=base64:RXmA9erMCe+s3qc4Dmyffy6vumqjEolf083K3pTNkkY=

# ============================
# 游戏平台代理配置（零信任隧道）
# ============================

# 是否启用代理（转发所有第三方游戏相关接口到外网主机）
GAME_PLATFORM_PROXY_ENABLE=true

# 外网主机地址（gk_work 项目 - 内网专用）
GAME_PLATFORM_PROXY_HOST=127.0.0.1

# 外网主机端口（内网 Nginx 专用端口）
GAME_PLATFORM_PROXY_PORT=8080

# 是否启用 Telegram 通知（true=每次转发都通知，false=禁用）
GAME_PLATFORM_PROXY_TELEGRAM_NOTIFY=true

# Telegram Bot Token（用于发送代理转发通知）
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID（接收通知的群组或个人 ID）
TELEGRAM_CHAT_ID=

# ============================
# 数据库配置
