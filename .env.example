# ============================
# api- 单一钱包API和机台任务进程
# 端口: 8788
# ============================

APP_DEBUG=true
APP_ENV=dev
APP_KEY=base64:RXmA9erMCe+s3qc4Dmyffy6vumqjEolf083K3pTNkkY=

# ============================
# 游戏平台代理配置（零信任隧道）
# ============================

# 是否启用代理（转发所有第三方游戏相关接口到外网主机）
GAME_PLATFORM_PROXY_ENABLE=true

# 外网主机地址（gk_work 项目 - 内网专用）
GAME_PLATFORM_PROXY_HOST=127.0.0.1

# 外网主机端口（内网 Nginx 专用端口）
GAME_PLATFORM_PROXY_PORT=8080

# 是否启用 Telegram 通知（true=每次转发都通知，false=禁用）
GAME_PLATFORM_PROXY_TELEGRAM_NOTIFY=true

# Telegram Bot Token（用于发送代理转发通知）
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID（接收通知的群组或个人 ID）
TELEGRAM_CHAT_ID=

# ============================
# 数据库配置
# ============================

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=super9
DB_USERNAME=super9
DB_PASSWORD=your_db_password_here

# 读写分离配置
DB_READ_HOST=127.0.0.1
DB_READ_USERNAME=super9
DB_READ_PASSWORD="your_db_password_here"

DB_WRITE_HOST=127.0.0.1
DB_WRITE_USERNAME=super9
DB_WRITE_PASSWORD="your_db_password_here"

# ============================
# Redis 配置
# ============================

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================
# WebSocket Push 服务配置
# ============================

# WebSocket 连接地址（前端使用）
WS_URL=wss://api-test.5super9.com

# Push API 地址（后端发送消息使用）
# 使用内网 IP 通信，速度更快且安全
PUSH_API_URL=http://127.0.0.1:3232

# Push 应用密钥（需要与 API 服务器 Push 配置一致）
PUSH_APP_KEY=your_push_app_key_here
PUSH_APP_SECRET=your_push_app_secret_here

# ============================
# Google Cloud Storage 配置
# ============================

GOOGLE_CLOUD_KEY_FILE=comechat-d5578-b1ad675314bd.json
GOOGLE_CLOUD_PROJECT_ID=comechat-d5578
GOOGLE_CLOUD_STORAGE_BUCKET=yjbfile
GOOGLE_CLOUD_STORAGE_PREFIX=test

# 移动端播放器 License URL
# 用于腾讯云播放器 SDK 的授权验证（移动应用专用）
# 注意：这里配置的是移动端（iOS/Android）的 License，与 Web 端不同
MOBILE_PLAYER_LICENSE=https://1350132313.trtcube-license.cn/license/v2/1350132313_1/v_cube.license

# 移动端播放器 License Key
# 与 License URL 配套使用
